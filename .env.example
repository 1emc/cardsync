BIND_ADDR=127.0.0.1:3000
PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=postgres://galcard:galcard@localhost:5432/galcard

# ADMIN_API_TOKEN and SUPPRESSION_SECRET must each be at least 32 characters.
# Generate strong values for anything but throwaway local testing, e.g.:
#   openssl rand -hex 32
ADMIN_API_TOKEN=dev-admin-token-change-me-to-32plus-chars
SUPPRESSION_SECRET=dev-suppression-secret-change-me-32plus

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

RUST_LOG=info
